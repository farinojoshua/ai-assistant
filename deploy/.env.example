# Copy to deploy/.env and fill in.  deploy/.env is auto-loaded by
# podman/docker compose (it sits next to the compose file).  NEVER commit it.
# deploy/setup.sh generates the secrets for you if you skip them.

# --- database passwords (any strong random strings, no quotes) ---
POSTGRES_PASSWORD_APP=changeme_app
POSTGRES_PASSWORD_COMPANY=changeme_company

# --- auth ---
JWT_SECRET=changeme_long_random
SEED_ADMIN_EMAIL=admin@perusahaan.com
SEED_ADMIN_PASSWORD=changeme

# --- LLM (Ollama Cloud) ---
LLM_PROVIDER=ollama_cloud
LLM_MODEL=gpt-oss:120b
LLM_VISION_MODEL=gemma4:31b
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=

# --- public address ---
# exactly how users reach the site (scheme + host, no trailing slash;
# comma-separated for several). Use a domain so Caddy gets HTTPS
# automatically — required for phone-camera uploads.
#   e.g. https://asisten.perusahaan.com
CORS_ORIGINS=http://YOUR-VPS-IP

# --- WhatsApp Cloud API (optional; leave blank to disable) ---
# TOKEN: permanent System User token   PHONE_NUMBER_ID: sending number's id
# TO: default number for the web-chat echo toggle
# VERIFY_TOKEN: any string you invent, also pasted into Meta's webhook config
# APP_SECRET: Meta App > Settings > Basic; validates inbound webhook signatures
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# RELAY_TOKEN: shared secret for POST /api/wa/relay (n8n / forwarder path)
WHATSAPP_RELAY_TOKEN=

# --- company data ---
# 1 = load the sample stok/karyawan/transaksi on first boot (demo)
# 0 = you will point COMPANY_DATABASE_URL at the real company DB instead
SEED_COMPANY_DATA=1
