# Copy to deploy/.env and fill in.  deploy/.env is auto-loaded by
# podman/docker compose (it sits next to the compose file).  NEVER commit it.
# deploy/setup.sh generates the secrets for you if you skip them.

# --- database passwords (any strong random strings, no quotes) ---
POSTGRES_PASSWORD_APP=changeme_app
POSTGRES_PASSWORD_COMPANY=changeme_company

# --- auth ---
JWT_SECRET=changeme_long_random
SEED_ADMIN_EMAIL=admin@perusahaan.com
SEED_ADMIN_PASSWORD=changeme

# --- LLM (Ollama Cloud) ---
LLM_PROVIDER=ollama_cloud
LLM_MODEL=gpt-oss:120b
LLM_VISION_MODEL=gemma4:31b
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=

# --- public address ---
# how users reach the site: scheme + host, no trailing slash.
# comma-separated if more than one.
CORS_ORIGINS=http://43.156.79.22

# --- company data ---
# 1 = load the sample stok/karyawan/transaksi on first boot (demo)
# 0 = you will point COMPANY_DATABASE_URL at the real company DB instead
SEED_COMPANY_DATA=1
