# Copy to deploy/.env.prod and fill in. NEVER commit deploy/.env.prod
# setup.sh generates the passwords/secret automatically if you skip them.

# --- database passwords (any strong random strings) ---
POSTGRES_PASSWORD_APP=
POSTGRES_PASSWORD_COMPANY=

# --- auth ---
JWT_SECRET=
SEED_ADMIN_EMAIL=admin@perusahaan.com
SEED_ADMIN_PASSWORD=

# --- LLM (Ollama Cloud) ---
LLM_PROVIDER=ollama_cloud
LLM_MODEL=gpt-oss:120b
LLM_VISION_MODEL=gemma4:31b
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=

# --- public address ---
# CORS must list exactly how users reach the site (scheme + host, no trailing slash)
CORS_ORIGINS=["http://43.156.79.22"]

# --- company data ---
# 1 = load the sample stok/karyawan/transaksi on first boot (demo)
# 0 = you will point COMPANY_DATABASE_URL at the real company DB instead
SEED_COMPANY_DATA=1
