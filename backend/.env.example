# App
APP_DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app
COMPANY_DATABASE_URL=postgresql+psycopg://company:company@localhost:5433/company
JWT_SECRET=dev-secret-change-me
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=14

# LLM
# Ollama Cloud free tier: gpt-oss:20b, gpt-oss:120b, nemotron-3-nano:30b,
# gemma4:31b work. Larger models (qwen3.5, deepseek-v4, mistral-large) need
# a paid subscription (HTTP 402).
LLM_PROVIDER=ollama_cloud
LLM_MODEL=gpt-oss:120b
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Agent
AGENT_MAX_ITERATIONS=8
AGENT_TOOL_TIMEOUT_S=15
AGENT_MAX_TOOL_CALLS_PER_TURN=8

# WhatsApp Cloud API (optional)
#   TOKEN            : permanent System User token (Meta App > WhatsApp > API Setup)
#   PHONE_NUMBER_ID  : the sending number's id (same screen)
#   TO               : default target for the web-chat -> WA echo toggle
#   VERIFY_TOKEN     : any string you invent; paste the same value into Meta's
#                      webhook config so GET /api/wa/webhook verifies
#   APP_SECRET       : Meta App > Settings > Basic > App Secret; validates the
#                      X-Hub-Signature-256 on inbound webhooks (leave blank to skip in dev)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
#   RELAY_TOKEN      : shared secret for POST /api/wa/relay — a simpler inbound
#                      path for n8n / another forwarder that can't sign like Meta
WHATSAPP_RELAY_TOKEN=
